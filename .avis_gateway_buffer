/* ;@DESC: OpenGL Hardware Pulse Monitor */

#include <GL/glut.h>
#include <sys/shm.h>
#include <stdio.h>

unsigned char *pulse_ptr;

void display() {
    glClear(GL_COLOR_BUFFER_BIT);
    glBegin(GL_LINE_STRIP);
    glColor3f(0.0f, 1.0f, 0.0f); // Sentinel Green

    for (int i = 0; i < 32; i++) {
        float x = ((float)i / 31.0f) * 2.0f - 1.0f;
        float y = ((float)pulse_ptr[64 + i] / 255.0f) * 2.0f - 1.0f;
        glVertex2f(x, y);
    }

    glEnd();
    glFlush();
    glutPostRedisplay();
}

int main(int argc, char** argv) {
    int shmid = shmget(0x0F17E6E3, 16384, 0666);
    pulse_ptr = shmat(shmid, NULL, SHM_RDONLY);

    glutInit(&argc, argv);
    glutCreateWindow("SENTINEL-OS LIVE PULSE");
    glutDisplayFunc(display);
    glutMainLoop();
    return 0;
}
