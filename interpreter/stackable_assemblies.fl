static inline void FlattenBufferTraceOutput(const char* absolute_trace_target) {
    if (absolute_trace_target == NULL) return;
    printf("[SENTINEL_MATRIX] Flattening trace indices for: %s -> State set to active flat schema\n", absolute_trace_target);
}
