{
  "sentinel_environment": {
    "version": "ev.4",
    "workspace_id": "mercwar",
    "local_root_path": "C:\\MercwarAI\\Sentinel\\",
    "build_profile": "MSVC-Win11-Production"
  },
  "ev4_boot_sequence": {
    "initialize_gateways": true,
    "runtime_loader": "PrepareSystem.exe",
    "compiler_directive": "cl main.c engine_core.c data_lake.c stargate_routes.c utils.c /I .\\curl\\include /link .\\curl\\lib\\libcurl.lib user32.lib advapi32.lib wsock32.lib gdi32.lib /OUT:PrepareSystem.exe"
  },
  "architecture_manifest": {
    "headers": [
      "linear_sync.h",
      "config.h",
      "engine_core.h",
      "data_lake.h",
      "stargate_routes.h"
    ],
    "source_modules": [
      "main.c",
      "engine_core.c",
      "data_lake.c",
      "stargate_routes.c",
      "utils.c"
    ]
  },
  "ev4_data_lake_mappings": {
    "uplink_format": "/dl/<year>/<month>/<day>/*json",
    "persistence_engine": "Sentinel-Core",
    "viewport_gateways": {
      "deployment_root": "https://github.io",
      "active_surfaces": [
        "/Station",
        "/Stargate",
        "/NEXUS",
        "/AVIS-DATALAKE"
      ]
    }
  }
}
