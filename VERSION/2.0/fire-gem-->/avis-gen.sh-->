#!/bin/bash
# ;@ENGINE: BGIN.AVIS_CJS_v2.0
# ;@DESC: Path-Sanitized Ingestor for CVBGOD Master Mode

set -euo pipefail
source "$(dirname "$0")/fire-root.sh"

GEM_PATH="/dev/shm/fire_gem_0xF17E6E3"
[[ ! -f "$GEM_PATH" ]] && fallocate -l 16384 "$GEM_PATH" 2>/dev/null

TEMP_RAW=".avis_raw_buffer"
: > "$TEMP_RAW"

echo "[BGIN] SANITIZED PULSE ACTIVE. INGESTING..."

while IFS= read -r -t 2 line || [[ -n "$line" ]]; do
	echo "$line" >> "$TEMP_RAW"
	case "$line" in
		"#!#" | "<!-- #!# -->" | "#!# RECOVERY_SIG_MATCHED") break ;;
	esac
done

# --- THE BIT-PERFECT FIX: PRECISION PATH STRIPPING ---
# This cleans out '-->', whitespace, and leading slashes
COORD_DIR=$(grep -i -m1 "avis_coord_dir" "$TEMP_RAW" | awk -F': ' '{print $2}' | sed 's| -->||g; s|^/||; s|[[:space:]]*$||' | tr -d '\r')
COORD_FILE=$(grep -i -m1 "avis_coord_file" "$TEMP_RAW" | awk -F': ' '{print $2}' | sed 's| -->||g; s|[[:space:]]*$||' | tr -d '\r')

TARGET_DIR="${V_ROOT}/${COORD_DIR}"
TARGET_PATH="${TARGET_DIR}/${COORD_FILE}"

mkdir -p "$TARGET_DIR"
cat "$TEMP_RAW" > "$TARGET_PATH"
cat "$TEMP_RAW" > "$GEM_PATH"
chmod 755 "$TARGET_PATH"

echo "------------------------------------------------"
echo "[AVIS] SANITIZED INSTALL SUCCESS: $TARGET_PATH"
echo "[BGIN] BYTES REFLECTED: $(wc -c < "$GEM_PATH")"
echo "------------------------------------------------"
#!#
