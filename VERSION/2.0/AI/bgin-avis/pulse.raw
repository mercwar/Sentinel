# #[avis] begin template bash
# ;@PROTOCOL: BGIN.AVIS-GEN.V2.01
# ;@AUTHORITY: CVBGOD (2ED0213EFEFE9340)
# avis_coord_dir: VERSION/2.0/fire-gem
# avis_coord_file: debug_gem.sh

#BGIN
#!/bin/bash
GEM_KEY="0x0f17e6e3"
# DETECT SHM_ID
SHM_ID=$(ipcs -m | grep "$GEM_KEY" | awk '{print $2}')

if [ -z "$SHM_ID" ]; then
    echo "[ERROR] FIRE-GEM NOT FOUND. RUN mz_reflector FIRST."
    exit 1
fi

echo "[BGIN] ATTACHED TO GEM ID: $SHM_ID"

while true; do
    clear
    echo "[BGIN] MONITORING SEGMENT: $GEM_KEY | ID: $SHM_ID"
    echo "--------------------------------------------------"
    # Use ipcs to peek the actual memory stats
    ipcs -m -i "$SHM_ID" | grep -A 3 "Last Operation"
    echo "--------------------------------------------------"
    echo "[AVIS] MZ SIGNATURE CHECK (HEX):"
    # Create a temporary peek via the /dev/shm interface if available
    # Or use the reflector's internal pulse log
    hexdump -n 16 -C /dev/shm/fire_gem_0xF17E6E3 2>/dev/null || echo "[WAITING FOR MZ PULSE...]"
    sleep 1
done
#!# RECOVERY_SIG_MATCHED
