// 1. SHMOP AUTHORITY CHECK
if (!function_exists('shmop_open')) {
    echo "[BGIN] SHMOP MISSING. ATTEMPTING EMERGENCY INGESTION...\n";
    passthru("sudo apt-get update && sudo apt-get install -y php-shmop");
    echo "[AVIS] EXTENSION PULSED. PLEASE RE-RUN.\n";
    exit(1);
}

// 2. ANCHOR CONSTANTS
$shm_key = 0x0f17e6e3;
$offset = 0x40; 

// 3. PEEK AT PULSE
$shm_id = @shmop_open($shm_key, "a", 0, 0);

if (!$shm_id) {
    die("[WAITING] SHM 0x0f17e6e3 NOT FOUND. IS THE REFLECTOR PULSING?\n");
}

$raw_data = shmop_read($shm_id, $offset, 32);
$hex_data = bin2hex($raw_data);

echo "\n--- SENTINEL-OS PORTAL PULSE ---\n";
echo "RAW DATA: " . $raw_data . "\n";
echo "HEX PEEK: " . strtoupper(chunk_split($hex_data, 2, ' ')) . "\n";
echo "--------------------------------\n";

shmop_close($shm_id);
?>
RECOVERY_SIG_MATCHED
