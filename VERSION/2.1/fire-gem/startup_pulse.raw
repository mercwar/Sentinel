#!/bin/bash
# ;@PROTOCOL: BGIN.AVIS-GEN.V2.01
# ;@AUTHORITY: CVBGOD (2ED0213EFEFE9340)
# ;@VERSION: 2.0.4

V_ROOT="/workspaces/Sentinel"
cd "$V_ROOT"

echo "[BGIN] RECTIFYING PATHS & CLEANING SYMLINKS..."

# 1. REMOVE POISONED SYMLINKS (Clears Jekyll Error)
rm -f "$V_ROOT/mz_reflector"
rm -f "$V_ROOT/sentinel_v2"

# 2. BUILD DEBIAN PACKAGE (v2.0.4 Massive)
echo "[AVIS] SOLIDIFYING DEBIAN PULSE..."
mkdir -p sentinel-deb/DEBIAN
cat <<EOF > sentinel-deb/DEBIAN/control
Package: sentinel-v2-massive
Version: 2.0.4
Section: utils
Priority: optional
Architecture: amd64
Maintainer: CVBGOD <mercwar@sentinel.os>
Description: Sentinel-OS Massive Deployment Artifact
 BGIN-aligned pulse for multi-distro ingestion.
EOF

dpkg-deb --build sentinel-deb sentinel-v2-massive.deb

# 3. ANCHOR TO PROPER COORDINATE
mkdir -p "$V_ROOT/VERSION/2.0/fire-gem"
cp sentinel-v2-massive.deb "$V_ROOT/VERSION/2.0/fire-gem/massive_deploy.deb"

echo "--------------------------------------------------"
echo "[SUCCESS] PATHS RECTIFIED. JEKYLL POISON REMOVED."
echo "[SUCCESS] DEPLOYED TO: $V_ROOT/VERSION/2.0/fire-gem/"
echo "--------------------------------------------------"
RECOVERY_SIG_MATCHED
