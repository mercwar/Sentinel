#[avis] begin template sh
#!/bin/bash
#BGIN
// avis sentinel example:
/* AVIS_COORD_DIR: VERSION/v2.0 */
/* AVIS_COORD_FILE: template.sh */
/* AVIS_ROLE: SOURCE_FILE */

; #FIRE!END# DO NOT MODIFY
